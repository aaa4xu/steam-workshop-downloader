<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>steam-workshop-downloader</AssemblyName>
    <RootNamespace>SteamWorkshopDownloader</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep test projects in-repo without accidentally compiling their sources into the main app. -->
    <Compile Remove="steam-workshop-downloader.Tests\\**\\*.cs" />
    <None Remove="steam-workshop-downloader.Tests\\**\\*" />
  </ItemGroup>

</Project>
